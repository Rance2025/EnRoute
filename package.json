{
  "name": "enroute",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "api": "python scripts/api_server.py",
    "dev:full": "python start.py start",
    "install:api": "python scripts/install_api.py",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "prepare:admin-regions": "python scripts/prepare_admin_regions.py",
    "prepare:footprints": "python scripts/import_footprints.py",
    "rebuild:footprints": "python scripts/rebuild_footprints_wgs84.py",
    "prepare:footprint-tiles": "python scripts/build_footprint_visual_tiles.py",
    "prepare:admin-region-tiles": "python scripts/build_admin_region_tiles.py",
    "test": "npm run test:web && npm run test:api && npm run test:repo",
    "test:web": "node scripts/run-web-tests.mjs",
    "test:api": "python scripts/run_api_tests.py",
    "test:repo": "python scripts/run_repo_tests.py",
    "preview": "npm --workspace apps/web run preview"
  }
}
